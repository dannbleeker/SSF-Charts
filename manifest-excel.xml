<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">

  <Id>c8a7e4b3-5d2f-4f9b-8a3c-8e6d1b2f7a54</Id>
  <Version>1.0.1.0</Version>
  <ProviderName>SSF Charts (open source)</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="SSF Charts Link" />
  <Description DefaultValue="Excel companion for SSF Charts: turn a selected range into a chart config to paste into PowerPoint." />
  <IconUrl DefaultValue="https://localhost:3000/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/assets/icon-64.png" />
  <SupportUrl DefaultValue="https://github.com/dannbleeker/SSF-Charts" />

  <Hosts>
    <Host Name="Workbook" />
  </Hosts>

  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <!--
        1.1 IS DERIVED, AND WAS NOT BEFORE. This block used to carry the
        PowerPoint manifest's reasoning verbatim — "ShapeCollection.addGeometricShape
        / addLine / addTextBox" — three APIs this add-in never calls, and which
        in Excel arrive at ExcelApi 1.9, not 1.1. So the comment argued for a
        floor nine sets above the number sitting beside it, and an auditor reading
        it could only conclude the number was never derived at all.

        RE-DERIVED 2026-09-20 from `src/excel/excel.ts` — the whole companion —
        and confirmed against the built bundle, which adds nothing to it. It
        reaches the Excel object model in exactly four places:

          Excel.run(batch)              the Excel object model's entry point. The
                                        `Excel` namespace exists wherever ExcelApi
                                        does, and 1.1 is the lowest set there is.
          Workbook.getSelectedRange()   ExcelApi 1.1
          Range.values                  ExcelApi 1.1
          Range.address                 ExcelApi 1.1

        Sets read member by member off the `@remarks [Api set: ...]` annotations
        in `node_modules/@types/office-js/index.d.ts`, the generated mirror of
        Microsoft's reference. `context.sync()` is `OfficeExtension`, and
        `Office.onReady` / `Office.context.host` are Common API — neither is a
        member of any ExcelApi set, so neither raises the floor. The highest of
        the four is 1.1. The floor is 1.1.

        AND IT CANNOT BE USED TO HEDGE, in either direction. Partner Center
        derives the certified platform list from this block (office-js#6658,
        certification policy 1120.3 — the argument is written out in full in
        `manifest.xml`), so a floor that is too LOW enlarges what Microsoft
        certifies, and a floor that is too HIGH locks out hosts the pane runs on
        perfectly. Neither is available here: a pane that only reads the selected
        range needs 1.1, and 1.1 is also the floor of the set. There is no number
        to move.

        `test/excel-companion-manifest.test.ts` re-derives that surface from the
        source instead of citing this comment — so a fifth call fails there,
        rather than quietly invalidating the number.
      -->
      <Set Name="ExcelApi" MinVersion="1.1" />
    </Sets>
  </Requirements>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3000/src/excel/excel.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title" />
            <Description resid="GetStarted.Description" />
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl" />
          </GetStarted>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="SSFChartsLink.Group">
                <Label resid="Group.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16" />
                  <bt:Image size="32" resid="Icon.32" />
                  <bt:Image size="80" resid="Icon.80" />
                </Icon>
                <Control xsi:type="Button" id="SSFChartsLink.OpenPane">
                  <Label resid="OpenPane.Label" />
                  <Supertip>
                    <Title resid="OpenPane.Label" />
                    <Description resid="OpenPane.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16" />
                    <bt:Image size="32" resid="Icon.32" />
                    <bt:Image size="80" resid="Icon.80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>SSFChartsLinkPane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://localhost:3000/assets/icon-16.png" />
        <bt:Image id="Icon.32" DefaultValue="https://localhost:3000/assets/icon-32.png" />
        <bt:Image id="Icon.80" DefaultValue="https://localhost:3000/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://localhost:3000/src/excel/excel.html" />
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://github.com/dannbleeker/SSF-Charts" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Group.Label" DefaultValue="SSF Charts" />
        <bt:String id="OpenPane.Label" DefaultValue="SSF Charts data" />
        <bt:String id="GetStarted.Title" DefaultValue="SSF Charts loaded" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="OpenPane.Tooltip" DefaultValue="Generate an SSF Charts config from the selected range." />
        <!--
          THE CALLOUT HAS TO DESCRIBE THIS ADD-IN, not the other one. Until
          2026-09-20 this string was the PowerPoint manifest's word for word —
          "…and insert your first chart" — and in Excel that is an instruction
          nobody can follow: the companion has no insert path at all (see the
          Requirements comment; its entire Excel surface is reading the selected
          range). This is the FIRST thing a new user or a validation tester
          meets, because the host pops it once, on install.

          It now names the pane's primary button verbatim, and
          `test/excel-companion-manifest.test.ts` checks the two against each
          other so a relabelled button cannot leave the callout pointing at a
          control that is no longer there.
        -->
        <bt:String id="GetStarted.Description" DefaultValue="Find SSF Charts on the Home tab, select a data range, then use Generate from selection to build a config you paste into SSF Charts in PowerPoint." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
